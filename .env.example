# Application under test
BASE_URL=http://localhost:3000

# Auth credentials (used by auth.setup.ts to seed storage state)
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=changeme
TEST_ADMIN_EMAIL=admin@example.com
TEST_ADMIN_PASSWORD=changeme

# API access for setup/teardown
API_BASE_URL=http://localhost:3000/api
API_KEY=

# AI features (optional — tests run without this)
AI_ENABLED=false
ANTHROPIC_API_KEY=

# CI sharding (set by CI orchestrator)
# SHARD_INDEX=1
# SHARD_TOTAL=4
